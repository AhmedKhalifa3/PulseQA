# PulseQA Environment Configuration Template

# Target Server
ENV=local
BASE_URL=http://127.0.0.1:8000
WS_URL=ws://127.0.0.1:8000

# Browser & UI Automation
BROWSER=chrome
HEADLESS=true
IMPLICIT_WAIT=5
EXPLICIT_WAIT=10
PAGE_LOAD_TIMEOUT=30
WINDOW_WIDTH=1920
WINDOW_HEIGHT=1080

# Mobile Automation (Appium)
APPIUM_SERVER_URL=http://127.0.0.1:4723
DEVICE_NAME=Android Emulator
PLATFORM_VERSION=14.0
MOBILE_BROWSER=Chrome

# Resource Consumption Telemetry & SLAs
ENABLE_RESOURCE_MONITORING=true
TELEMETRY_INTERVAL_SEC=0.2
MAX_ALLOWED_RAM_MB=1500.0
MAX_ALLOWED_CPU_PCT=250.0

# Enterprise TestRail Integration
TESTRAIL_ENABLED=false
TESTRAIL_MOCK_MODE=true
TESTRAIL_URL=https://pulseqa.testrail.io
TESTRAIL_USER=qa_automator@pulseqa.local
TESTRAIL_API_KEY=mock_api_key_12345
TESTRAIL_PROJECT_ID=1
TESTRAIL_SUITE_ID=101
